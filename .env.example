# Server Configuration
PORT=3000
NODE_ENV=development

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=webrtc_voice
DB_USER=postgres
DB_PASSWORD=your_password

# Optional: Database connection pool
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# WebSocket Security Configuration
# Allowed origins for WebSocket connections (comma-separated)
# In production, set to your actual domains
# Example: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Trust proxy headers (x-forwarded-for) for IP extraction
# IMPORTANT: Only set to 'true' if behind a trusted reverse proxy (Nginx, Apache, etc.)
# Setting to 'true' without a proxy allows IP spoofing attacks
# Default: false in production (uses direct socket IP)
TRUST_PROXY=false

# WebSocket authentication (optional, for future JWT implementation)
WS_REQUIRE_AUTH=false

# Session secret (for CSRF protection and sessions)
# Generate a strong random string for production
SESSION_SECRET=your-secret-key-change-this-in-production
